# 测试环境配置
NODE_ENV=test

# JWT配置
JWT_SECRET=test-jwt-secret-key-for-testing-only
JWT_EXPIRATION=1800
JWT_REFRESH_EXPIRATION=604800

# 登录安全配置
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=600

# 双因素认证配置
TWO_FACTOR_REQUIRED_LEVEL=3
TWO_FACTOR_ISSUER=DNF GM Tools Test

# 设备信任配置
DEVICE_TRUST_DURATION=2592000

# 数据库配置（测试数据库）
DB_GM_TOOLS_HOST=localhost
DB_GM_TOOLS_PORT=3306
DB_GM_TOOLS_USER=test_user
DB_GM_TOOLS_PASSWORD=test_password
DB_GM_TOOLS_DATABASE=test_gm_tools
DB_GM_TOOLS_POOL_SIZE=5

# 日志配置
LOG_LEVEL=error
LOG_DIR=./logs/test
