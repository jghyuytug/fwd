# ========================================
# DNF GM工具系统 - 后端环境变量配置
# ========================================

# 应用配置
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# 数据库配置（GM工具数据库）
DB_HOST=localhost
DB_PORT=3307
DB_NAME=gm_tools
DB_USER=root
DB_PASSWORD=TestRootPass123456
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEZONE=+08:00

# 镜像数据库配置（只读）
MIRROR_DB_HOST=localhost
MIRROR_DB_PORT=3307
MIRROR_DB_CAIN=taiwan_cain_mirror
MIRROR_DB_LOGIN=taiwan_login_mirror
MIRROR_DB_USER=gm_tools_reader
MIRROR_DB_PASSWORD=CHANGE_ME_READER_PASSWORD
MIRROR_DB_POOL_MIN=2
MIRROR_DB_POOL_MAX=10

# JWT配置
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_characters
JWT_EXPIRATION=1800
REFRESH_TOKEN_EXPIRATION=604800
JWT_ALGORITHM=HS256

# 2FA配置
TWO_FACTOR_ISSUER=DNF_GM_Tools
TWO_FACTOR_WINDOW=2
TWO_FACTOR_REQUIRED_LEVEL=3

# 设备信任配置
DEVICE_TRUST_DURATION=2592000
DEVICE_TOKEN_LENGTH=64

# 限流配置
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_LOGIN_MAX=5

# 登录安全配置
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=600
PASSWORD_MIN_LENGTH=8

# 日志配置
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# CORS配置
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
CORS_CREDENTIALS=true

# Swagger配置
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs

# 健康检查
HEALTH_CHECK_PATH=/health
