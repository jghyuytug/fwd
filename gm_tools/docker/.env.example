# DNF GM工具 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# Week 3 基础设施配置

# ========================================
# MySQL 配置
# ========================================

# GM镜像数据库root密码（强密码，至少16位）
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# GM工具服务数据库用户
GM_DB_USER=gm_tools_user
GM_DB_PASSWORD=CHANGE_ME_GM_DB_PASSWORD

# ========================================
# Canal 配置
# ========================================

# 生产数据库地址（Canal连接）
PRODUCTION_DB_HOST=192.168.1.100
PRODUCTION_DB_PORT=3306

# Canal同步用户（由DBA创建）
CANAL_DB_USER=gm_mirror
CANAL_DB_PASSWORD=CHANGE_ME_CANAL_PASSWORD

# ========================================
# Grafana 配置
# ========================================

# Grafana管理员账号
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ========================================
# 生产环境标识
# ========================================

# 环境标识：development / staging / production
ENVIRONMENT=development

# 调试模式
DEBUG=false

# ========================================
# 安全配置
# ========================================

# JWT密钥将在部署时自动生成
# 无需手动配置

# ========================================
# 网络配置
# ========================================

# 外部访问域名
DOMAIN=gm.dnf.game

# ========================================
# 密码生成建议
# ========================================

# 使用以下命令生成强密码：
# openssl rand -base64 24

# ========================================
# 填写检查清单
# ========================================

# [ ] MYSQL_ROOT_PASSWORD - 已填写强密码
# [ ] GM_DB_PASSWORD - 已填写
# [ ] CANAL_DB_PASSWORD - 已从DBA获取
# [ ] PRODUCTION_DB_HOST - 已填写生产数据库IP
# [ ] GRAFANA_ADMIN_PASSWORD - 已填写

# ========================================
# 安全提醒
# ========================================

# ⚠️ 重要：
# 1. .env文件已添加到.gitignore，不会提交到版本控制
# 2. 生产环境密码必须使用强密码（16位+，包含大小写字母、数字、特殊字符）
# 3. 定期轮换密码（建议每季度）
# 4. 不要在Slack/邮件等明文传输密码
