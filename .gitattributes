# Auto detect text files and perform LF normalization
* text=auto

# Source code - always LF
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.toml text eol=lf

# Makefiles - always LF (required for proper execution)
Makefile text eol=lf
*.mk text eol=lf

# Windows scripts - always CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - no normalization
*.pvf binary
*.npk binary
*.NPK binary
*.bin binary
*.dat binary
*.exe binary
*.dll binary
*.so binary
*.a binary
*.lib binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
